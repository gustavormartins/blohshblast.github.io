{
  "name": "blohsh-blast",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run test && npm run security:test && npm run build",
    "audit": "npm audit --audit-level=high",
    "security:test": "node tests/security/source-policy.mjs",
    "security:live": "node tests/security/live-site-smoke.mjs",
    "e2e:serve": "npm run build && vite preview --host 127.0.0.1 --port 4173"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "vitest": "5.0.3"
  }
}
