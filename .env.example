# Public browser configuration only.
# NEVER put database credentials, JWT secrets, API keys, or private tokens in VITE_* variables.
VITE_API_BASE_URL=

# Server-only values belong in the selected API host's secret manager.
# DATABASE_URL = Supabase Transaction Pooler connection string (port 6543)
# JWT_SECRET = unique random 32+ byte signing secret
# FRONTEND_ORIGIN = https://blohsh-blast.vercel.app
# PG_SSL_CA = optional PEM certificate authority if required
